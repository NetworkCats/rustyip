[sshd]
enabled   = true
port      = ssh
filter    = sshd
maxretry  = 5
findtime  = 600
bantime   = 3600

# Use iptables directly instead of UFW
banaction         = iptables-multiport
banaction_allports = iptables-allports

# Debian 13 logs to the journal only (no rsyslog, so no /var/log/auth.log)
backend   = systemd
